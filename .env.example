# TradeBot-Production-V2 — example environment file
# Copy to .env and fill REAL values locally. NEVER commit the real .env.

# Prisma datasource (local dev only; unused by the trading engine, which uses
# the KV storage under db/trading_data.json)
DATABASE_URL="file:./db/custom.db"

# Session cookie signing secret (REQUIRED in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Pre-seeded admin credentials (optional — otherwise first login sets them)
# AUTH_USERNAME="admin"
# AUTH_PASSWORD="change-me"

# Cron endpoint secret — the Cloudflare worker must send this header
X_CRON_SECRET="change-me-cron-secret"

# Optional: override runtime KV data file location
# TB_DATA_FILE="db/trading_data.json"
