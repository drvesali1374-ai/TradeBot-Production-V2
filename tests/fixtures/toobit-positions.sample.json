[
  {
    "_comment": "Sanitized fixtures for getOpenPositions mapping tests — fields per official Toobit docs (api-docs.toobit.com). profitRate/unrealizedPnL semantics: amounts in USDT, rates are FRACTIONS (x100 for % display).",
    "cases": [
      {
        "name": "long-win",
        "raw": { "symbol": "BTC-SWAP-USDT", "side": "LONG", "avgPrice": "60000", "position": "10", "available": "10", "leverage": "2", "margin": "11.9825", "marginRate": "0.4992", "unrealizedPnL": "12.5", "profitRate": "0.1043", "markPrice": "60683.5", "marginType": "ISOLATED" },
        "expected": { "unrealizedPnL": 12.5, "profitRatePct": 10.43, "entryPrice": 60000, "markPrice": 60683.5, "qty": 10, "side": "LONG" }
      },
      {
        "name": "long-loss",
        "raw": { "symbol": "ETH-SWAP-USDT", "side": "LONG", "avgPrice": "3000.5", "position": "4", "available": "4", "leverage": "3", "margin": "4.0006", "unrealizedPnL": "-2.35", "profitRate": "-0.5874", "markPrice": "2824.1", "marginType": "CROSSED" },
        "expected": { "unrealizedPnL": -2.35, "profitRatePct": -58.74, "entryPrice": 3000.5, "markPrice": 2824.1, "qty": 4, "side": "LONG" }
      },
      {
        "name": "short-win",
        "raw": { "symbol": "SOL-SWAP-USDT", "side": "SHORT", "avgPrice": "150.25", "position": "20", "available": "20", "leverage": "5", "margin": "6.01", "unrealizedPnL": "3.05", "profitRate": "0.5075", "markPrice": "144.9", "marginType": "ISOLATED" },
        "expected": { "unrealizedPnL": 3.05, "profitRatePct": 50.75, "entryPrice": 150.25, "markPrice": 144.9, "qty": 20, "side": "SHORT" }
      },
      {
        "name": "short-loss",
        "raw": { "symbol": "DOGE-SWAP-USDT", "side": "SHORT", "avgPrice": "0.085", "position": "1000", "available": "1000", "leverage": "2", "margin": "42.5", "unrealizedPnL": "-5.1", "profitRate": "-0.12", "markPrice": "0.0935", "marginType": "ISOLATED" },
        "expected": { "unrealizedPnL": -5.1, "profitRatePct": -12, "entryPrice": 0.085, "markPrice": 0.0935, "qty": 1000, "side": "SHORT" }
      },
      {
        "name": "zero-pnl",
        "raw": { "symbol": "XRP-SWAP-USDT", "side": "LONG", "avgPrice": "0.52", "position": "100", "available": "100", "leverage": "1", "margin": "5.72", "unrealizedPnL": "0", "profitRate": "0", "markPrice": "0.52", "marginType": "CROSSED" },
        "expected": { "unrealizedPnL": 0, "profitRatePct": 0, "entryPrice": 0.52, "markPrice": 0.52, "qty": 100, "side": "LONG" }
      },
      {
        "name": "missing-fields",
        "raw": { "symbol": "ADA-SWAP-USDT", "side": "LONG", "position": "50" },
        "expected": { "unrealizedPnL": null, "profitRatePct": null, "entryPrice": null, "markPrice": null, "qty": 50, "side": "LONG" }
      },
      {
        "name": "invalid-values",
        "raw": { "symbol": "LTC-SWAP-USDT", "side": "SHORT", "avgPrice": "not-a-number", "position": "abc", "leverage": "2", "unrealizedPnL": "NaN", "profitRate": null, "markPrice": "" },
        "expected": { "unrealizedPnL": null, "profitRatePct": null, "entryPrice": null, "markPrice": null, "qty": null, "side": "SHORT", "leverage": 2 }
      }
    ]
  }
]
