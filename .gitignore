# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
.claude
.z-ai-config
*.log
dev.log
dev.out.log
prompt

server.log
# Skills directory
/skills/

# internal tooling artifacts (cached source reads — not project source)
/tool-results/
.zscripts/dev.pid
.zscripts/dev.log
# local runtime data (secrets live here — NEVER commit)
/db/*.json
/db/*.db
/db/*.sqlite
/db/*.sqlite-*
*.db-journal
# sanitized example fixtures ARE committed (structure only, fake values)
!.env.example
!/db/trading_data.example.json
